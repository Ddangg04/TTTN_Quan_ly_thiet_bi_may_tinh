[{"id":15,"title":"NukeViet 4.3 c\u00f3 g\u00ec m\u1edbi?","link":"\/nukeviet\/index.php?language=vi&amp;nv=news&amp;op=San-pham\/nukeviet-4-3-co-gi-moi-15.html","imgurl":"\/nukeviet\/assets\/news\/chuc-mung-nukeviet-thong-tu-20-bo-tttt.jpg","width":"70","hometext":"NukeViet 4.3 l\u00e0 phi\u00ean b\u1ea3n n\u00e2ng c\u1ea5p c\u1ee7a phi\u00ean b\u1ea3n NukeViet 4.2 t\u1eadp trung v\u00e0o vi\u1ec7c fix c\u00e1c v\u1ea5n \u0111\u1ec1 b\u1ea5t c\u1eadp c\u00f2n t\u1ed3n t\u1ea1i, t\u1ed1i \u01b0u tr\u1ea3i nghi\u1ec7m c\u1ee7a ng\u01b0\u1eddi d\u00f9ng.","external_link":1,"newday":1510388707},{"id":14,"title":"NukeViet 4.2 c\u00f3 g\u00ec m\u1edbi?","link":"\/nukeviet\/index.php?language=vi&amp;nv=news&amp;op=San-pham\/nukeviet-4-2-co-gi-moi-14.html","imgurl":"\/nukeviet\/assets\/news\/chuc-mung-nukeviet-thong-tu-20-bo-tttt.jpg","width":"70","hometext":"NukeViet 4.2 l\u00e0 phi\u00ean b\u1ea3n n\u00e2ng c\u1ea5p c\u1ee7a phi\u00ean b\u1ea3n NukeViet 4.0 t\u1eadp trung v\u00e0o vi\u1ec7c fix c\u00e1c v\u1ea5n \u0111\u1ec1 b\u1ea5t c\u1eadp c\u00f2n t\u1ed3n t\u1ea1i c\u1ee7a NukeViet 4.0, Th\u00eam c\u00e1c t\u00ednh n\u0103ng m\u1edbi \u0111\u1ec3 t\u0103ng c\u01b0\u1eddng b\u1ea3o m\u1eadt c\u1ee7a h\u1ec7 th\u1ed1ng c\u0169ng nh\u01b0 t\u1ed1i \u01b0u tr\u1ea3i nghi\u1ec7m c\u1ee7a ng\u01b0\u1eddi d\u00f9ng.","external_link":1,"newday":1502010420}]